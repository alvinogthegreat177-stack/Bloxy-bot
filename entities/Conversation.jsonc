{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "default": "New Chat"
    },
    "folder": {
      "type": "string",
      "default": ""
    },
    "is_favorite": {
      "type": "boolean",
      "default": false
    },
    "provider": {
      "type": "string",
      "enum": [
        "auto",
        "deepseek",
        "openai",
        "claude",
        "groq",
        "openrouter",
        "cohere",
        "mistral"
      ],
      "default": "auto"
    },
    "model": {
      "type": "string",
      "default": ""
    },
    "message_count": {
      "type": "number",
      "default": 0
    },
    "last_message_preview": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
